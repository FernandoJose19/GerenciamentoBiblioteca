@model Autor

@{
    ViewData["Title"] = "Excluir Autor";
}

<h2>Excluir Autor</h2>

<div class="alert alert-danger">
    Deseja realmente excluir este autor?
</div>

<div class="card">
    <div class="card-body">
        <p><strong>Nome:</strong> @Model.Nome</p>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Confirmar exclusão
    </button>

    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
