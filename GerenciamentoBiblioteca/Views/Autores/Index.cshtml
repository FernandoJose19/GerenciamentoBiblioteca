@model IEnumerable<Autor>

@{
    ViewData["Title"] = "Autores";
}

<div class="d-flex justify-content-between mb-4">
    <h2>✍️ Autores</h2>
    <a asp-action="Create" class="btn btn-success">+ Novo Autor</a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Nome</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var autor in Model)
        {
            <tr>
                <td>@autor.Nome</td>
                <td>
                    <a asp-action="Details" asp-route-id="@autor.Id"
                       class="btn btn-info btn-sm">Detalhes</a>
                    <a asp-action="Edit" asp-route-id="@autor.Id"
                       class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@autor.Id"
                       class="btn btn-danger btn-sm">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
