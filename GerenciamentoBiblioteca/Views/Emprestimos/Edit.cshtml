@model Emprestimo
@{ ViewData["Title"] = "Editar Empréstimo"; var devolvido = Model.DataDevolucao.HasValue; }
<div class="page-header mb-4"><div><h1 class="h3 mb-1">Editar empréstimo</h1><p class="text-secondary mb-0">@(devolvido ? "Apenas a previsão original pode ser corrigida em um empréstimo devolvido." : "Altere o livro, o leitor ou a previsão de devolução.")</p></div></div>
<div class="card shadow-sm border-0"><div class="card-body p-4">
<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
 @Html.AntiForgeryToken()<input type="hidden" asp-for="Id" />
 <div asp-validation-summary="All" class="text-danger mb-3"></div>
 @if (devolvido)
 {
  <input type="hidden" asp-for="LivroId" /><input type="hidden" asp-for="LeitorId" />
  <div class="mb-3"><label class="form-label">Livro</label><input class="form-control" value="@Model.Livro?.Titulo" readonly /></div>
  <div class="mb-3"><label class="form-label">Leitor</label><input class="form-control" value="@Model.Leitor?.Nome" readonly /></div>
  <div class="alert alert-info">O livro, o leitor e a data efetiva da devolução são preservados para manter a integridade do histórico.</div>
 }
 else
 {
  <div class="mb-3"><label asp-for="LivroId" class="form-label">Livro</label><select asp-for="LivroId" asp-items="ViewBag.Livros" class="form-select"><option value="">Selecione um livro</option></select><span asp-validation-for="LivroId" class="text-danger"></span></div>
  <div class="mb-3"><label asp-for="LeitorId" class="form-label">Leitor</label><select asp-for="LeitorId" asp-items="ViewBag.Leitores" class="form-select"><option value="">Selecione um leitor</option></select><span asp-validation-for="LeitorId" class="text-danger"></span></div>
 }
 <div class="mb-3"><label asp-for="DataPrevistaDevolucao" class="form-label">Previsão de devolução</label><input asp-for="DataPrevistaDevolucao" type="date" value="@Model.DataPrevistaDevolucao.ToString("yyyy-MM-dd")" class="form-control" /><span asp-validation-for="DataPrevistaDevolucao" class="text-danger"></span></div>
 @if (!devolvido) { <div class="alert alert-info">A troca do livro ajusta automaticamente o estoque. A data original do empréstimo não pode ser alterada.</div> }
 <button type="submit" class="btn btn-primary">Salvar alterações</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
