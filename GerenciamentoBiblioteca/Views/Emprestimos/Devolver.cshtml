@model Emprestimo

@{
    ViewData["Title"] = "Devolver Livro";
}

<div class="container mt-4">
    <h2>Registrar Devolução</h2>

    <div class="card">
        <div class="card-body">

            <p>
                <strong>Livro:</strong>
                @Model.Livro?.Titulo
            </p>

            <p>
                <strong>Leitor:</strong>
                @Model.Leitor?.Nome
            </p>

            <p>
                <strong>Data do Empréstimo:</strong>
                @Model.DataEmprestimo.ToShortDateString()
            </p>

            <p>
                <strong>Previsão de Devolução:</strong>
                @Model.DataPrevistaDevolucao.ToShortDateString()
            </p>

            @if (Model.DataDevolucao != null)
            {
                <div class="alert alert-info">
                    Este livro já foi devolvido.
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    Confirma a devolução deste livro?
                </div>

                <form asp-action="Devolver" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <button type="submit" class="btn btn-success">
                        Confirmar Devolução
                    </button>
                </form>
            }

            <a asp-action="Index" class="btn btn-secondary mt-2">
                Voltar
            </a>
        </div>
    </div>
</div>
