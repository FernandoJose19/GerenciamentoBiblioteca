@model IEnumerable<Emprestimo>
@{ ViewData["Title"] = "Empréstimos"; }

@if (TempData["Sucesso"] != null) { <div class="alert alert-success alert-dismissible fade show">@TempData["Sucesso"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Erro"] != null) { <div class="alert alert-danger alert-dismissible fade show">@TempData["Erro"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Aviso"] != null) { <div class="alert alert-warning alert-dismissible fade show">@TempData["Aviso"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
 <div><h1 class="h3 mb-1">Empréstimos</h1><p class="text-secondary mb-0">Acompanhe retiradas, prazos e devoluções.</p></div>
 <a asp-action="Create" class="btn btn-success">+ Novo empréstimo</a>
</div>
@if (Model == null || !Model.Any())
{
 <div class="alert alert-info text-center"><h5>Nenhum empréstimo cadastrado.</h5><p class="mb-0">Registre o primeiro empréstimo para começar.</p></div>
}
else
{
 <div class="card border-0 shadow-sm"><div class="card-body p-0"><div class="table-responsive">
 <table class="table table-hover align-middle mb-0">
  <thead class="table-dark"><tr><th>Livro</th><th>Leitor</th><th>Data do empréstimo</th><th>Previsão de devolução</th><th>Devolução</th><th>Situação</th><th class="text-nowrap">Ações</th></tr></thead>
  <tbody>
  @foreach (var emprestimo in Model)
  {
   var devolvido = emprestimo.DataDevolucao.HasValue;
   var atrasado = !devolvido && emprestimo.DataPrevistaDevolucao.Date < DateTime.Today;
   <tr>
    <td class="fw-semibold">@emprestimo.Livro?.Titulo</td><td>@emprestimo.Leitor?.Nome</td>
    <td>@emprestimo.DataEmprestimo.ToString("dd/MM/yyyy")</td><td>@emprestimo.DataPrevistaDevolucao.ToString("dd/MM/yyyy")</td>
    <td>@(devolvido ? emprestimo.DataDevolucao!.Value.ToString("dd/MM/yyyy") : "Pendente")</td>
    <td>@if (devolvido) { <span class="badge bg-success">Devolvido</span> } else if (atrasado) { <span class="badge bg-danger">Atrasado</span> } else { <span class="badge bg-warning text-dark">Emprestado</span> }</td>
    <td class="text-nowrap">
     <a asp-action="Details" asp-route-id="@emprestimo.Id" class="btn btn-info btn-sm">Detalhes</a>
     <a asp-action="Edit" asp-route-id="@emprestimo.Id" class="btn btn-warning btn-sm">Editar</a>
     @if (!devolvido)
     {
      <form asp-action="Devolver" asp-route-id="@emprestimo.Id" method="post" class="d-inline" onsubmit="return confirm('Confirma a devolução deste livro?');">@Html.AntiForgeryToken()<button type="submit" class="btn btn-success btn-sm">Devolver</button></form>
     }
     <a asp-action="Delete" asp-route-id="@emprestimo.Id" class="btn btn-danger btn-sm">Excluir</a>
    </td>
   </tr>
  }
  </tbody>
 </table></div></div></div>
}
