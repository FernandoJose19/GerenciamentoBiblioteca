@model IEnumerable<Leitor>

@{
    ViewData["Title"] = "Leitores";
}

<div class="d-flex justify-content-between mb-4">
    <h2>👥 Leitores</h2>
    <a asp-action="Create" class="btn btn-success">+ Novo Leitor</a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Nome</th>
            <th>Email</th>
            <th>Telefone</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var leitor in Model)
        {
            <tr>
                <td>@leitor.Nome</td>
                <td>@leitor.Email</td>
                <td>@leitor.Telefone</td>
                <td>
                    <a asp-action="Details" asp-route-id="@leitor.Id" class="btn btn-info btn-sm">Detalhes</a>
                    <a asp-action="Edit" asp-route-id="@leitor.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Delete" asp-route-id="@leitor.Id" class="btn btn-danger btn-sm">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
