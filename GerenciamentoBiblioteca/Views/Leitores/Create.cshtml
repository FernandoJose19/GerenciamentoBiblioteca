@model Leitor

@{
    ViewData["Title"] = "Cadastrar Leitor";
}

<h2>Cadastrar Leitor</h2>

<form asp-action="Create" method="post" data-prevent-double-submit="true">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Nome" class="form-label">Nome</label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">E-mail</label>
        <input asp-for="Email" type="email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Telefone" class="form-label">Telefone</label>
        <input asp-for="Telefone" type="tel" class="form-control" data-mask="telefone" placeholder="(00) 00000-0000" />
        <div class="form-text">Informe o DDD e o número do telefone.</div>
        <span asp-validation-for="Telefone" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
