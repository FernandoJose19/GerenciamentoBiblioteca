@model Leitor

@{
    ViewData["Title"] = "Detalhes do Leitor";
}

<h2>Detalhes do Leitor</h2>

<div class="card">
    <div class="card-body">
        <p><strong>Código:</strong> @Model.Id</p>
        <p><strong>Nome:</strong> @Model.Nome</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Telefone:</strong> @Model.Telefone</p>
    </div>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id"
   class="btn btn-warning mt-3">Editar</a>

<a asp-action="Index" class="btn btn-secondary mt-3">Voltar</a>
