@{
    ViewData["Title"] = "Página Inicial";
}

<section class="home-hero">
    <div class="app-card-icon" style="width:4.5rem;height:4.5rem;font-size:2.35rem">📚</div>
    <h1>Biblioteca MVC</h1>
    <p class="lead mb-2">Sistema de Gerenciamento de Biblioteca</p>
    <p class="text-secondary mb-0">Organize o acervo, acompanhe leitores e controle empréstimos em um só lugar.</p>
</section>

